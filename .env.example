# Password for the admin dashboard at /admin (required in production)
ADMIN_PASSWORD=change-me-to-something-long

# Random string used to sign admin login cookies. Keep it secret and stable
# so admins stay logged in across restarts.
SESSION_SECRET=replace-with-a-long-random-string

# Currency used for prices (ISO code, e.g. GBP, EUR, USD, MUR)
CURRENCY=GBP

# Timezone used to decide what "today" is when validating dates
TZ=Europe/London

# Where bookings are stored (SQLite file). Defaults to ./data/luxe-display.db
# DB_FILE=/var/data/luxe-display.db

PORT=3000
NODE_ENV=production
